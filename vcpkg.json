{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg-configuration.schema.json",
  "name": "sim",
  "version-string": "0.1.0",
  "dependencies": [
    "bitloop",
    "brotli",
    {
      "name": "dawn",
      "default-features": false,
      "features": [
        {
          "name": "dxc",
          "platform": "windows"
        },
        {
          "name": "metal",
          "platform": "osx | ios"
        },
        {
          "name": "vulkan",
          "platform": "linux | android"
        }
      ]
    }
  ]
}
